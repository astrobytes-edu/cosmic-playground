---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import DemoCard from "../../components/DemoCard.astro";
import FilterBar from "../../components/FilterBar.astro";
import EmptyState from "../../components/EmptyState.astro";
import HeroOrbit from "../../components/HeroOrbit.astro";
import TopicIcon from "../../components/TopicIcon.astro";
import { topicColor } from "../../lib/topicColors";
import { READINESS_ORDER, readinessRank } from "../../lib/readiness";
import {
  TOPIC_LABEL,
  TOPIC_ORDER,
  TOPIC_SUMMARY,
  topicPath
} from "../../lib/topics";
import {
  demoKeyIdea,
  listedDemos,
  normalizeBasePathPath,
  parseIsoDate,
  playlistMembershipMap
} from "../../lib/catalog";

const demos = listedDemos(await getCollection("demos"));
const playlists = await getCollection("playlists");

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => normalizeBasePathPath(path, base);
const exploreHref = withBase("explore/");

/*
 * No `Astro.url.searchParams` here. This page is prerendered (`output: "static"`), so
 * frontmatter runs once at build time with every parameter empty -- reading filters here
 * is what made the entire filter bar inert. The page now renders the FULL catalogue and
 * `explore/filters.ts` narrows it in the browser, where the query string actually exists.
 */
const topics = Array.from(new Set(demos.flatMap((d) => d.data.topics))).sort();
const readinesses = READINESS_ORDER.filter((r) => demos.some((d) => d.data.readiness === r));
/* `Both` is a tag meaning "either course", not a course a reader can pick. */
const levels = ["ASTR101", "ASTR201"];

const playlistBySlug = new Map<string, (typeof playlists)[number]>(
  playlists.map((playlist) => [playlist.slug, playlist] as [string, (typeof playlists)[number]])
);
const playlistCounts = playlistMembershipMap(playlists);

const featuredOrder = ["keplers-laws", "retrograde-motion", "binary-orbits"];
const featured = demos
  .filter((d) => d.data.featured)
  .sort(
    (a, b) =>
      featuredOrder.indexOf(a.slug) - featuredOrder.indexOf(b.slug) ||
      a.data.title.localeCompare(b.data.title)
  );

function excerptFromBody(body: string) {
  const firstLine = body
    .split("\n")
    .map((l) => l.trim())
    .find((l) => l.length > 0 && !l.startsWith("---"));
  if (!firstLine) return "\u2014";
  return firstLine.replace(/^#+\s*/, "").slice(0, 140);
}

type QuickFilterKey = "astr101" | "updated";

/*
 * Every demo is rendered, in the default "recommended" order, and the client script
 * hides what the active filters exclude. A demo with two topics is rendered in both of
 * its topic sections, so counts must be taken over distinct slugs, not over cards.
 */
const sorted = [...demos].sort(
  (a, b) =>
    readinessRank(a.data.readiness) - readinessRank(b.data.readiness) ||
    parseIsoDate(b.data.last_updated) - parseIsoDate(a.data.last_updated) ||
    a.data.title.localeCompare(b.data.title)
);

/*
 * Two chips. `lt10`, `noMath` and `labs` were removed on 2026-09-09 -- see the note on
 * QUICK_FILTER_KEYS in exploreFilter.ts for the counts that condemned them. The short
 * version: two were exact duplicates of a select, and `labs` matched all 19 demos.
 */
const quickLabels: Record<QuickFilterKey, string> = {
  astr101: "ASTR 101",
  updated: "New / Updated"
};

/*
 * Hrefs, not buttons: with JS disabled these are ordinary links to a URL the script reads
 * on load, so the chips still communicate what they do. The script intercepts the click
 * to filter in place rather than round-tripping to a page that cannot honour the query.
 */
const quickFilterItems: Array<{ key: QuickFilterKey; label: string; href: string }> = (
  ["astr101", "updated"] as const
).map((key) => ({
  key,
  label: quickLabels[key],
  href: `${exploreHref}?quick=${key}`
}));

const featuredSlugs = new Set(featured.map((d) => d.slug));

const topicSections = TOPIC_ORDER.map((key) => ({
  key,
  label: TOPIC_LABEL[key],
  demos: sorted.filter((d) => d.data.topics.includes(key as any))
})).filter((section) => section.demos.length > 0);

const allSlugs = demos.map((d) => d.slug);
const randomSlug = allSlugs[Math.floor(Math.random() * allSlugs.length)];

/*
 * Free-text haystack for the search box; the card lowercases it with its own title.
 *
 * `misconceptions` is in here because it is the field a reader's own words are most
 * likely to match. Every demo declares at least one -- 37 across the 19 listed on
 * 2026-09-09 -- and they are written in the student's voice ("If something looks bigger,
 * it must be physically bigger"). Someone looking for help with a class that believes
 * summer happens because Earth is closer to the Sun types that, not "EarthSky".
 */
const searchTextFor = (d: (typeof demos)[number]) =>
  `${d.data.tags.join(" ")} ${d.data.learning_goals.join(" ")} ${d.data.misconceptions.join(" ")}`;

type StartHereTile = {
  title: string;
  playlistSlug?: string;
  topicKey?: string;
  fallbackHref: string;
};

const startHereTiles: StartHereTile[] = [
  {
    title: "Astro 101 Core",
    playlistSlug: "astro-101-core-concepts",
    fallbackHref: withBase("playlists/")
  },
  {
    title: "Solar System Geometry",
    playlistSlug: "solar-system-geometry",
    fallbackHref: `${exploreHref}?topic=EarthSky`
  },
  {
    title: "Orbits & Gravity",
    playlistSlug: "orbits-and-gravity",
    fallbackHref: `${exploreHref}?topic=Orbits`
  },
  {
    title: "Light & Telescopes",
    playlistSlug: "light-and-measuring-the-universe",
    fallbackHref: `${exploreHref}?topic=LightSpectra`
  },
  {
    title: "Measurement & Distance",
    topicKey: "DataInference",
    fallbackHref: `${exploreHref}?topic=DataInference`
  }
];

const startHere = startHereTiles.map((tile) => {
  const playlist = tile.playlistSlug ? playlistBySlug.get(tile.playlistSlug) : null;
  if (playlist) {
    return {
      ...tile,
      href: withBase(`playlists/${playlist.slug}/`),
      minutes: playlist.data.estimated_minutes,
      demoCount: playlist.data.demos.length
    };
  }

  const related = demos.filter((demo) =>
    tile.topicKey ? demo.data.topics.includes(tile.topicKey as any) : false
  );
  const minutes = related.reduce((sum, demo) => sum + demo.data.time_minutes, 0);
  return {
    ...tile,
    href: tile.fallbackHref,
    minutes,
    demoCount: related.length
  };
});
---

<Layout title="Explore — Cosmic Playground" hasMath={false}>
  <section class="explore-hero cp-hero">
    <div class="explore-hero__content">
      <h1>Explore</h1>
      <p class="explore-hero__identity">An interactive museum of astronomy reasoning instruments.</p>
      <p class="explore-hero__identity-sub">
        Explore observables, models, and inferences—like doing experiments on ideas.
      </p>
      <p class="explore-hero__tagline">Play with the universe. Learn the physics.</p>
      <div class="site-state-note cp-card" role="note" aria-label="Project state">
        Cosmic Playground is in active beta. A badge on an exhibit says how ready it is to assign; an exhibit with no badge is finished.
      </div>
    </div>
    <div class="explore-hero__motion" aria-hidden="true">
      <HeroOrbit />
    </div>
  </section>

  <section class="start-here" aria-label="Start here playlists and entry points">
    <div class="start-here__header">
      <h2>Start here</h2>
      <a href={withBase("playlists/")}>Looking for a guided path?</a>
    </div>
    <div class="start-here__grid">
      {startHere.map((tile) => (
        <a class="start-here__tile cp-card" href={tile.href}>
          <h3>{tile.title}</h3>
          <p class="start-here__meta">~{tile.minutes} min · {tile.demoCount} demos</p>
        </a>
      ))}
    </div>
  </section>

  <FilterBar topics={topics} levels={levels} readinesses={readinesses} />

  <nav class="quick-filters" aria-label="Quick filters">
    {quickFilterItems.map((item) => (
      <a class="cp-chip quick-filters__chip" href={item.href} data-quick={item.key} aria-pressed="false">
        {item.label}
      </a>
    ))}
  </nav>

  <div class="filter-chips" aria-label="Active filters" data-filter-chips hidden></div>


  {featured.length > 0 ? (
    <section class="featured" aria-label="Featured sequence" data-unfiltered-only>
      <div class="featured__header">
        <h2>Featured sequence</h2>
        <p class="featured__lede">Begin with the core orbit ideas before branching out.</p>
      </div>
      <div class="results__grid">
        {featured.map((d) => (
          <DemoCard
            title={d.data.title}
            slug={d.slug}
            href={withBase(`exhibits/${d.slug}/`)}
            description={excerptFromBody(d.body)}
            status={d.data.status}
            readiness={d.data.readiness}
            topics={d.data.topics}
            levels={d.data.levels}
            timeMinutes={d.data.time_minutes}
            hasMathMode={d.data.has_math_mode}
            keyIdea={demoKeyIdea(d)}
            playHref={normalizeBasePathPath(d.data.demo_path, base)}
            stationHref={normalizeBasePathPath(d.data.station_path, base)}
            instructorHref={normalizeBasePathPath(d.data.instructor_path, base)}
            playlistCount={playlistCounts.get(d.slug) ?? 0}
            playlistHref={`${withBase("playlists/")}?demo=${encodeURIComponent(d.slug)}`}
          />
        ))}
      </div>
    </section>
  ) : null}

  <div class="explore-onboard" data-unfiltered-only>
      <ul class="explore-onboard__cadence" aria-label="Predict, Play, Explain">
        <li>Predict</li>
        <li>Play</li>
        <li>Explain</li>
      </ul>
    <p class="explore-onboard__lede">A simple loop for every exhibit.</p>
  </div>

  <div class="results__count">
    <span class="results__count-value" data-result-count>{sorted.length}</span>
    <span class="results__count-unit" data-result-unit>interactive exhibits</span>
    <a
      class="cp-button cp-button--ghost results__surprise"
      href={withBase(`exhibits/${randomSlug}/`)}
      data-all-slugs={JSON.stringify(allSlugs)}
    >
      Surprise me
    </a>
  </div>

  <nav class="topic-index" aria-label="Jump to topic" data-unfiltered-only>
      {topicSections.map((section) => (
        <a class="cp-chip topic-index__link" href={`#topic-${section.key.toLowerCase()}`}>
          {section.label}
      </a>
    ))}
  </nav>

  <section class="results" aria-label="Demo results">
    <div class="cp-section">
      {topicSections.map((section) => (
        <div class="topic-section" id={`topic-${section.key.toLowerCase()}`} data-topic-section={section.key}>
          <div class="topic-section__header" style={`--topic-color: ${topicColor(section.key)}`}>
            <TopicIcon topic={section.key} size={28} />
            <div>
              <h2 class="topic-section__title">
                <a href={withBase(topicPath(section.key))}>{section.label}</a>
              </h2>
              <p class="topic-section__desc">{TOPIC_SUMMARY[section.key]}</p>
            </div>
            <span class="topic-section__count" data-section-count hidden></span>
          </div>
          <div class="results__grid">
            {section.demos.map((d) => (
              <DemoCard
                title={d.data.title}
                slug={d.slug}
                href={withBase(`exhibits/${d.slug}/`)}
                description={excerptFromBody(d.body)}
                status={d.data.status}
                readiness={d.data.readiness}
                topics={d.data.topics}
                levels={d.data.levels}
                timeMinutes={d.data.time_minutes}
                hasMathMode={d.data.has_math_mode}
                keyIdea={demoKeyIdea(d)}
                playHref={normalizeBasePathPath(d.data.demo_path, base)}
                stationHref={normalizeBasePathPath(d.data.station_path, base)}
                instructorHref={normalizeBasePathPath(d.data.instructor_path, base)}
                playlistCount={playlistCounts.get(d.slug) ?? 0}
                playlistHref={`${withBase("playlists/")}?demo=${encodeURIComponent(d.slug)}`}
                lastUpdated={d.data.last_updated}
                searchText={searchTextFor(d)}
                misconceptions={d.data.misconceptions}
                featured={featuredSlugs.has(d.slug)}
              />
            ))}
          </div>
        </div>
      ))}
    </div>

    <div data-empty-state hidden>
      <EmptyState />
    </div>
  </section>
</Layout>

<script>
  import {
    EMPTY_FILTERS,
    FILTER_KEYS,
    NARROWING_KEYS,
    compareDemos,
    facetCount,
    hasNarrowingFilter,
    matches,
    matchesQuery,
    readFilters,
    toSearchParams
  } from "../../lib/exploreFilter";
  import type { DemoFacets, FilterKey, Filters, NarrowingKey } from "../../lib/exploreFilter";

  const results = document.querySelector(".results");
  const form = document.querySelector("[data-filter-form]");

  if (results instanceof HTMLElement && form instanceof HTMLFormElement) {
    /* Narrowing does not reach hoisted function declarations, so pin the type here. */
    const filterForm: HTMLFormElement = form;
    /*
     * Only cards inside a topic section are catalogue entries. The featured strip renders
     * three of the same demos again as a presentation device; counting those would report
     * 23 exhibits for a catalogue of 20.
     */
    const cards = [...results.querySelectorAll<HTMLElement>("[data-topic-section] .demo-card")];
    const sections = [...results.querySelectorAll<HTMLElement>("[data-topic-section]")];
    const unfilteredOnly = [...document.querySelectorAll<HTMLElement>("[data-unfiltered-only]")];
    const chipBox = document.querySelector<HTMLElement>("[data-filter-chips]");
    const emptyState = results.querySelector<HTMLElement>("[data-empty-state]");
    const countValue = document.querySelector<HTMLElement>("[data-result-count]");
    const countUnit = document.querySelector<HTMLElement>("[data-result-unit]");
    const quickChips = [...document.querySelectorAll<HTMLAnchorElement>("[data-quick]")];
    const resetButton = document.querySelector<HTMLElement>("[data-filter-reset]");
    const searchInput = form.querySelector<HTMLInputElement>("input[name='q']");
    const selects = [...form.querySelectorAll<HTMLSelectElement>("select")];

    const facetsOf = (card: HTMLElement): DemoFacets => ({
      slug: card.dataset.slug ?? "",
      topics: (card.dataset.topics ?? "").split(" ").filter(Boolean),
      levels: (card.dataset.levels ?? "").split(" ").filter(Boolean),
      timeMinutes: Number(card.dataset.time ?? "0"),
      readiness: card.dataset.readiness ?? "",
      hasMath: card.dataset.math === "yes",
      updated: card.dataset.updated ?? "",
      search: card.dataset.search ?? ""
    });

    /* One entry per DISTINCT demo; a two-topic demo has a card in each of its sections. */
    const catalogue = new Map<string, DemoFacets>();
    for (const card of cards) {
      const facets = facetsOf(card);
      if (facets.slug) catalogue.set(facets.slug, facets);
    }
    const allDemos = [...catalogue.values()];

    const CHIP_LABEL: Record<NarrowingKey, (value: string) => string> = {
      q: (v) => `Search: ${v}`,
      topic: (v) => `Topic: ${v}`,
      level: (v) => `Course: ${v.replace(/^ASTR/, "ASTR ")}`,
      time: (v) => `Time: ${optionLabel("time", v)}`,
      readiness: (v) => `Readiness: ${optionLabel("readiness", v)}`,
      math: (v) => `Math required: ${v === "yes" ? "Yes" : "No"}`,
      quick: (v) => `Quick: ${quickChips.find((c) => c.dataset.quick === v)?.dataset.label ?? v}`
    };

    function optionLabel(name: string, value: string): string {
      const select = filterForm.querySelector<HTMLSelectElement>(`select[name='${name}']`);
      const option = select?.querySelector<HTMLOptionElement>(`option[value='${value}']`);
      return option?.dataset.label ?? value;
    }

    for (const chip of quickChips) chip.dataset.label = chip.textContent?.trim() ?? "";

    let filters: Filters = { ...EMPTY_FILTERS };

    function render() {
      /*
       * `now` is read per render, not captured once: "New / Updated" is a 30-day window
       * measured from when the reader is looking. Evaluating it at build time -- which is
       * what the prerendered version did -- freezes the answer on the deploy date and
       * decays it to zero results as the published site ages.
       */
      const now = new Date();
      const visible = new Set(
        allDemos.filter((demo) => matches(demo, filters, now)).map((demo) => demo.slug)
      );
      const filtering = hasNarrowingFilter(filters);

      for (const card of cards) card.hidden = !visible.has(card.dataset.slug ?? "");
      showSearchMatches();

      /*
       * While unfiltered the three featured demos are shown by the strip above, so their
       * topic-section copies stay hidden -- the default view is unchanged. Filtering hides
       * the strip, so those copies must come back or the demos would vanish entirely.
       */
      if (!filtering) {
        for (const card of cards) {
          if (card.dataset.featured === "yes") card.hidden = true;
        }
      }

      for (const section of sections) {
        /*
         * A demo carries several topics and so has a card in each of their sections. When
         * the reader has asked for one topic, the other sections those demos also live in
         * must not appear -- asking for Orbits and getting an "Earth & Sky" heading reads
         * as the filter having failed, even though every card under it does match.
         */
        const sectionCards = [...section.querySelectorAll<HTMLElement>(".demo-card")];
        if (filters.topic !== "" && section.dataset.topicSection !== filters.topic) {
          for (const card of sectionCards) card.hidden = true;
        }
        const shown = sectionCards.filter((c) => !c.hidden);
        section.hidden = shown.length === 0;
        const badge = section.querySelector<HTMLElement>("[data-section-count]");
        if (badge) {
          badge.hidden = !filtering;
          badge.textContent = `${shown.length}`;
        }
      }

      for (const element of unfilteredOnly) element.hidden = filtering;

      if (emptyState) emptyState.hidden = visible.size > 0;
      if (countValue) countValue.textContent = `${visible.size}`;
      if (countUnit) {
        countUnit.textContent = `interactive exhibit${visible.size === 1 ? "" : "s"}`;
      }

      sortSections();
      renderChips();
      renderFacetCounts(now);

      for (const chip of quickChips) {
        const key = chip.dataset.quick ?? "";
        const active = filters.quick === key;
        chip.classList.toggle("quick-filters__chip--active", active);
        chip.setAttribute("aria-pressed", active ? "true" : "false");
        /*
         * Chips carry their yield too. It is the same honesty as the select counts, and
         * on this catalogue it is worth having: every demo ships a Station-mode lab, so
         * "Labs" narrows 19 to 19 -- a chip that reads (19) beside a total of 19 tells
         * the reader not to bother, and starts meaning something the day that changes.
         */
        const n = facetCount(allDemos, filters, "quick", key, now);
        chip.textContent = `${chip.dataset.label ?? ""} (${n})`;
      }
      if (resetButton) resetButton.hidden = !filtering && filters.sort === "recommended";
    }

    /*
     * Say why a card matched.
     *
     * Searching a misconception -- "closer to the sun", "bigger means closer" -- now
     * returns exhibits whose title and tags contain nothing of the sort. Without this the
     * reader gets a result they cannot connect to what they typed, which reads as the
     * search misfiring. The matched misconception is shown on the card, verbatim, so the
     * connection is explicit.
     *
     * Only shown when the term is NOT already visible in the title or description; if the
     * card says "Seasons" and you searched "seasons", nothing needs explaining.
     */
    function showSearchMatches() {
      const term = filters.q.toLowerCase().trim();
      for (const card of cards) {
        const slot = card.querySelector<HTMLElement>("[data-match]");
        if (!slot) continue;
        if (!term || card.hidden) {
          slot.hidden = true;
          continue;
        }

        const visibleText = `${card.querySelector(".demo-card__title")?.textContent ?? ""} ${
          card.querySelector(".demo-card__desc")?.textContent ?? ""
        }`.toLowerCase();
        if (matchesQuery(visibleText, term)) {
          slot.hidden = true;
          continue;
        }

        let list: string[] = [];
        try {
          list = JSON.parse(card.dataset.misconceptions ?? "[]");
        } catch {
          list = [];
        }
        const hit = list.find((m) => matchesQuery(m.toLowerCase(), term));
        slot.hidden = hit === undefined;
        slot.textContent = hit ?? "";
      }
    }

    function sortSections() {
      for (const section of sections) {
        const grid = section.querySelector<HTMLElement>(".results__grid");
        if (!grid) continue;
        const ordered = [...grid.querySelectorAll<HTMLElement>(".demo-card")].sort((a, b) => {
          const fa = catalogue.get(a.dataset.slug ?? "");
          const fb = catalogue.get(b.dataset.slug ?? "");
          if (!fa || !fb) return 0;
          return compareDemos(fa, fb, filters.sort);
        });
        for (const card of ordered) grid.append(card);
      }
    }

    function renderChips() {
      if (!chipBox) return;
      chipBox.textContent = "";
      const active = NARROWING_KEYS.filter((key) => filters[key] !== "");
      chipBox.hidden = active.length === 0;
      if (active.length === 0) return;

      for (const key of active) {
        const chip = document.createElement("button");
        chip.type = "button";
        chip.className = "cp-chip";
        chip.dataset.removeFilter = key;
        /*
         * An inline SVG cross, not a multiplication sign. The repo bans unicode math
         * glyphs in rendered text -- see the Math authoring rule in CLAUDE.md -- and a
         * remove affordance is an icon rather than an operator in any case.
         */
        chip.innerHTML =
          `${escapeHtml(CHIP_LABEL[key](filters[key]))}` +
          ` <svg class="cp-chip__remove" viewBox="0 0 16 16" width="12" height="12"` +
          ` aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"` +
          ` stroke-linecap="round"><path d="M4 4l8 8M12 4l-8 8"/></svg>`;
        chip.setAttribute("aria-label", `Remove filter ${CHIP_LABEL[key](filters[key])}`);
        chipBox.append(chip);
      }

      const clear = document.createElement("button");
      clear.type = "button";
      clear.className = "cp-chip cp-chip--clear";
      clear.dataset.clearFilters = "";
      clear.textContent = "Clear all";
      chipBox.append(clear);
    }

    /*
     * Each option carries the number of demos it would yield with the other axes held as
     * they are, and an option yielding none is disabled. This is what keeps the controls
     * honest about a small catalogue: with 20 demos, "20+ min" and several status values
     * match nothing at all, and the reader can see that without spending a click.
     */
    function renderFacetCounts(now: Date) {
      for (const select of selects) {
        const name = select.name as FilterKey;
        if (name === "sort") continue;
        for (const option of [...select.options]) {
          const label = option.dataset.label;
          if (!label) continue;
          const n = facetCount(allDemos, filters, name as NarrowingKey, option.value, now);
          option.textContent = `${label} (${n})`;
          option.disabled = n === 0 && option.value !== filters[name];
        }
      }
    }

    function escapeHtml(value: string): string {
      const div = document.createElement("div");
      div.textContent = value;
      return div.innerHTML;
    }

    function syncControls() {
      if (searchInput) searchInput.value = filters.q;
      for (const select of selects) {
        const name = select.name as FilterKey;
        if (FILTER_KEYS.includes(name)) select.value = filters[name];
      }
      /* An advanced filter arriving by URL must not stay folded away inside <details>. */
      const advanced = filterForm.querySelector<HTMLDetailsElement>(".filter-bar__details");
      if (advanced && (filters.level || filters.readiness || filters.math)) advanced.open = true;
    }

    function pushUrl(replace: boolean) {
      const qs = toSearchParams(filters).toString();
      const url = qs ? `${location.pathname}?${qs}` : location.pathname;
      history[replace ? "replaceState" : "pushState"]({}, "", url);
    }

    function update(next: Partial<Filters>, replace = false) {
      filters = { ...filters, ...next };
      pushUrl(replace);
      render();
    }

    function adopt(search: string) {
      filters = readFilters(search);
      syncControls();
      render();
    }

    form.classList.add("is-enhanced");
    /* The form used to navigate to a URL the prerendered page could not honour. */
    form.addEventListener("submit", (event) => event.preventDefault());

    let timer = 0;
    searchInput?.addEventListener("input", () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => update({ q: searchInput.value.trim() }, true), 250);
    });

    for (const select of selects) {
      select.addEventListener("change", () => {
        update({ [select.name as FilterKey]: select.value } as Partial<Filters>);
        renderFacetCounts(new Date());
      });
    }

    for (const chip of quickChips) {
      chip.addEventListener("click", (event) => {
        event.preventDefault();
        update({ quick: filters.quick === chip.dataset.quick ? "" : chip.dataset.quick ?? "" });
        syncControls();
      });
    }

    chipBox?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const remove = target.closest<HTMLElement>("[data-remove-filter]");
      if (remove) {
        update({ [remove.dataset.removeFilter as FilterKey]: "" } as Partial<Filters>);
        syncControls();
        return;
      }
      if (target.closest("[data-clear-filters]")) {
        update({ ...EMPTY_FILTERS });
        syncControls();
      }
    });

    resetButton?.addEventListener("click", () => {
      update({ ...EMPTY_FILTERS });
      syncControls();
    });

    window.addEventListener("popstate", () => adopt(location.search));

    adopt(location.search);
  }

  const surpriseBtn = document.querySelector("[data-all-slugs]");
  if (surpriseBtn instanceof HTMLAnchorElement) {
    const slugs = JSON.parse(surpriseBtn.dataset.allSlugs || "[]");
    // The server-rendered href already carries the GitHub Pages base path. Rebuilding
    // the URL from `document.querySelector("base")` used to drop it (there is no <base>
    // element on this site), so the button worked with JS off and 404'd with JS on.
    // Swap only the slug segment of the real href and let the browser navigate.
    const template = surpriseBtn.getAttribute("href") || "";
    surpriseBtn.addEventListener("click", (e) => {
      if (slugs.length === 0) return;
      const slug = slugs[Math.floor(Math.random() * slugs.length)];
      const target = template.replace(/exhibits\/[^/]+\//, `exhibits/${slug}/`);
      if (target === template) return; // pattern did not match; keep the static href
      e.preventDefault();
      window.location.href = target;
    });
  }
</script>

