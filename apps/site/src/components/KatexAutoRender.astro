<script>
  import katex from "katex";
  import renderMathInElement from "katex/contrib/auto-render";

  const root = document.querySelector("main");
  if (root) {
    renderMathInElement(root, {
      delimiters: [
        { left: "$$", right: "$$", display: true },
        { left: "$", right: "$", display: false },
        { left: "\\[", right: "\\]", display: true },
        { left: "\\(", right: "\\)", display: false }
      ],
      ignoredTags: ["script", "noscript", "style", "textarea", "pre", "code"],
      // Markdown math is typeset at build time by rehype-katex (see astro.config.mjs), so
      // this pass must not walk back into it. What is left for it is math that never goes
      // through Markdown: frontmatter fields on the exhibit pages and Explore's excerpts.
      ignoredClasses: ["katex", "katex-display"],
      throwOnError: false,
      katex
    });

    // Display equations scroll horizontally on narrow viewports (see global.css).
    // A scrollable region must be reachable by keyboard: browsers do not make an
    // overflow container focusable on their own (WCAG 2.1.1).
    for (const node of root.querySelectorAll<HTMLElement>(".katex-display")) {
      if (node.scrollWidth > node.clientWidth) {
        node.tabIndex = 0;
        node.setAttribute("role", "region");
        node.setAttribute("aria-label", "Scrollable equation");
      }
    }
  }
</script>
