---
import Icon from "./Icon.astro";

/*
 * No current-value props. The page is prerendered, so any "selected" state computed here
 * is computed with empty filters -- which is why the controls used to snap back to "All"
 * after a filter navigation. The Explore script sets `.value` from the URL on load and
 * writes the per-option result counts.
 */
export type FilterBarProps = {
  topics: string[];
  levels: string[];
  statuses: string[];
};

const { topics, levels, statuses } = Astro.props as FilterBarProps;

const LEVEL_LABEL: Record<string, string> = {
  ASTR101: "ASTR 101",
  ASTR201: "ASTR 201"
};
---

<form class="filter-bar cp-card" method="get" action={`${import.meta.env.BASE_URL}explore/`} data-filter-form>
  <div class="filter-bar__row filter-bar__row--primary">
    <label class="filter-bar__field">
      <span class="filter-bar__label">Search exhibits</span>
      <div class="filter-bar__search">
        <Icon name="Search" size={18} class="filter-bar__search-icon" />
        <input
          class="cp-input"
          name="q"
          type="search"
          placeholder="Search demos…"
          autocomplete="off"
        />
      </div>
    </label>

    <label class="filter-bar__field">
      <span class="filter-bar__label">Choose a topic</span>
      <select class="cp-select" name="topic">
        <option value="">All</option>
        {topics.map((t) => (
          <option value={t} data-label={t}>{t}</option>
        ))}
      </select>
    </label>

    <label class="filter-bar__field">
      <span class="filter-bar__label">Time budget</span>
      <select class="cp-select" name="time">
        <option value="">Any</option>
        <option value="lt10" data-label="≤10 min">≤10 min</option>
        <option value="10to20" data-label="10–20 min">10–20 min</option>
        <option value="gt20" data-label="20+ min">20+ min</option>
      </select>
    </label>

    <label class="filter-bar__field">
      <span class="filter-bar__label">Sort by</span>
      <select class="cp-select" name="sort">
        <option value="recommended">Recommended</option>
        <option value="duration">Duration</option>
        <option value="level">Level</option>
        <option value="updated">Recently updated</option>
      </select>
    </label>
  </div>

  <div class="filter-bar__row filter-bar__row--secondary">
    <details class="filter-bar__details">
      <summary>More ways to filter</summary>
      <div class="filter-bar__more">
        <label class="filter-bar__field">
          <span class="filter-bar__label">Course level</span>
          <select class="cp-select" name="level">
            <option value="">All</option>
            {levels.map((l) => (
              <option value={l} data-label={LEVEL_LABEL[l] ?? l}>{LEVEL_LABEL[l] ?? l}</option>
            ))}
          </select>
        </label>

        <label class="filter-bar__field">
          <span class="filter-bar__label">Status</span>
          <select class="cp-select" name="status">
            <option value="">Any</option>
            {statuses.map((s) => (
              <option value={s} data-label={s}>{s}</option>
            ))}
          </select>
        </label>

        <label class="filter-bar__field">
          <span class="filter-bar__label">Math required?</span>
          <select class="cp-select" name="math">
            <option value="">Any</option>
            <option value="yes" data-label="Yes">Yes</option>
            <option value="no" data-label="No">No</option>
          </select>
        </label>
      </div>
    </details>

    <div class="filter-bar__actions">
      <button class="cp-button cp-button--ghost filter-bar__submit" type="submit">
        Apply
      </button>
      <button class="cp-button cp-button--ghost filter-bar__reset" type="button" data-filter-reset hidden>
        Clear filters
      </button>
    </div>
  </div>
</form>

<style>
  .filter-bar {
    position: sticky;
    top: 52px;
    z-index: calc(var(--cp-z-sticky) - 1);
    padding: var(--cp-space-3);
    display: grid;
    gap: var(--cp-space-2);
  }

  .filter-bar__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
    gap: var(--cp-space-2);
    align-items: end;
  }

  .filter-bar__row--secondary {
    grid-template-columns: 1fr auto;
    align-items: center;
  }

  .filter-bar__field {
    display: grid;
    gap: var(--cp-space-1);
  }

  .filter-bar__label {
    font-size: var(--cp-text-sm);
    color: var(--cp-muted);
  }

  .filter-bar__search {
    position: relative;
    display: flex;
    align-items: center;
  }

  .filter-bar__search-icon {
    position: absolute;
    left: 12px;
    color: var(--cp-muted);
    pointer-events: none;
  }

  .filter-bar__search input {
    padding-left: 40px;
  }

  .filter-bar__details {
    border: 0;
    padding: 0;
  }

  .filter-bar__details summary {
    cursor: pointer;
    list-style: none;
    color: var(--cp-muted);
    font-size: var(--cp-text-sm);
    margin-bottom: var(--cp-space-1);
  }

  .filter-bar__details summary::-webkit-details-marker {
    display: none;
  }

  .filter-bar__more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
    gap: var(--cp-space-2);
  }

  .filter-bar__actions {
    display: flex;
    gap: var(--cp-space-2);
    align-items: center;
  }

  /*
   * With the script running there is nothing to apply -- results update as you choose --
   * so the cell carries the one control that still does something. Without the script the
   * submit stays, because the form is then the only way to change the query string.
   */
  .filter-bar.is-enhanced .filter-bar__submit {
    display: none;
  }
</style>
