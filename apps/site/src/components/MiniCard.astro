---
/**
 * Compact demo card for horizontal scroll strips.
 *
 * Carries the same facts as the full card, in the space a scroll strip allows: what the
 * exhibit is about (topic), what it teaches (key idea), how long it takes, and whether it
 * is finished. It used to show only a thumbnail, a title, a topic icon with no label, and
 * a raw ISO date -- which told a reader nothing they could act on, and made the strip read
 * as decoration next to the "Start here" cards above it.
 */
import DemoCanvasThumbnail from "./DemoCanvasThumbnail.astro";
import TopicIcon from "./TopicIcon.astro";
import CardMeta from "./CardMeta.astro";
import { topicColor, primaryTopic } from "../lib/topicColors";
import { TOPIC_LABEL, isTopicKey } from "../lib/topics";

interface Props {
  title: string;
  slug: string;
  href: string;
  topics: string[];
  lastUpdated: string;
  status: "stable" | "beta" | "draft";
  readiness: "stub" | "experimental" | "candidate" | "launch-ready";
  /** The exhibit's first learning goal; math-free across the catalogue. */
  keyIdea?: string;
  timeMinutes: number;
  levels: string[];
}

const {
  title,
  slug,
  href,
  topics,
  lastUpdated,
  readiness,
  keyIdea,
  timeMinutes,
  levels
} = Astro.props;
const topic = primaryTopic(topics);
const color = topicColor(topic);
const topicLabel = isTopicKey(topic) ? TOPIC_LABEL[topic] : topic;

/* "Updated 4 Sep" beats "2026-09-04" on a card whose whole job is to be skimmed. */
const updatedLabel = (() => {
  const parsed = new Date(lastUpdated);
  if (Number.isNaN(parsed.getTime())) return lastUpdated;
  return parsed.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
})();
---

<a class="mini-card cp-card" href={href} style={`--topic-color: ${color}`}>
  <div class="mini-card__illustration">
    <DemoCanvasThumbnail slug={slug} />
  </div>
  <div class="mini-card__body">
    <span class="mini-card__topic">
      <TopicIcon topic={topic} size={12} />
      {topicLabel}
    </span>
    <span class="mini-card__title">{title}</span>
    {keyIdea ? <span class="mini-card__idea">{keyIdea}</span> : null}
    <CardMeta
      timeMinutes={timeMinutes}
      levels={levels}
      readiness={readiness}
      variant="compact"
    />
    <time class="mini-card__date" datetime={lastUpdated}>Updated {updatedLabel}</time>
  </div>
</a>

<style>
  .mini-card {
    display: flex;
    flex-direction: column;
    gap: var(--cp-space-2);
    min-width: 232px;
    max-width: 256px;
    text-decoration: none;
    flex-shrink: 0;
    overflow: clip;
    transition:
      transform 200ms var(--cp-ease-out),
      box-shadow 200ms var(--cp-ease-out),
      border-color 200ms var(--cp-ease-out);
  }

  .mini-card:hover {
    transform: translateY(-3px);
    box-shadow:
      var(--cp-card-shadow-hover),
      0 0 16px color-mix(in srgb, var(--topic-color) 10%, transparent);
    border-color: color-mix(in srgb, var(--topic-color) 30%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .mini-card { transition: none; }
    .mini-card:hover { transform: none; }
  }

  .mini-card__illustration {
    padding: var(--cp-space-2);
    background:
      radial-gradient(
        ellipse 80% 70% at 50% 50%,
        color-mix(in srgb, var(--topic-color) 6%, transparent) 0%,
        transparent 70%
      );
    border-bottom: 1px solid var(--cp-border-subtle);
  }

  .mini-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--cp-space-1);
    padding: var(--cp-space-3);
    flex: 1;
  }

  .mini-card__topic {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: var(--cp-text-xs);
    font-weight: var(--cp-font-medium);
    color: var(--topic-color);
  }

  .mini-card__title {
    font-weight: var(--cp-font-semibold);
    font-size: var(--cp-text-sm);
    color: var(--cp-title);
    line-height: var(--cp-leading-tight);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .mini-card:hover .mini-card__title {
    color: var(--cp-title-strong);
  }

  .mini-card__idea {
    font-size: var(--cp-text-xs);
    line-height: 1.45;
    color: var(--cp-text2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* The date is the least of the facts here, so it sits last and lightest. */
  .mini-card__date {
    margin-top: auto;
    padding-top: var(--cp-space-1);
    color: var(--cp-faint);
    font-family: var(--cp-font-mono);
    font-size: 0.7rem;
  }
</style>
